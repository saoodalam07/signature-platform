# ---- queue (local: Valkey; AWS: BROKER_URL=sqs://  RESULT_BACKEND=redis://<elasticache>:6379/1)
BROKER_URL=redis://valkey:6379/0
RESULT_BACKEND=redis://valkey:6379/1
AWS_REGION=us-east-1

# ---- storage for uploads (local volume or S3)
STORAGE_BACKEND=local
STORAGE_DIR=/data/uploads
S3_BUCKET=

# ---- MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=signature-detection

# ---- inference
MODEL_BACKEND=real
DETECT_THRESHOLD=0.40
MATCH_THRESHOLD=0.85
MODEL_CHECK_SECONDS=60

# ---- training pipeline (Hugging Face)
HF_DATASET_REPO=your-org/signature-dataset
HF_TOKEN=
HF_WEBHOOK_SECRET=change-me-long-random-string
TRAIN_EPOCHS=50
TRAIN_BATCH=4
PROMOTE_MIN_GAIN=0.0
