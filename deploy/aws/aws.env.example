# Copy to deploy/aws/aws.env on the EC2 server and fill in.
# The EC2 instance role gives access to SQS and S3: no AWS keys in this file.
DOMAIN=1-2-3-4.sslip.io            # your EC2 public IP with dashes + .sslip.io
AWS_REGION=ap-southeast-2
AWS_DEFAULT_REGION=ap-southeast-2
BROKER_URL=sqs://
RESULT_BACKEND=redis://valkey:6379/1
STORAGE_BACKEND=s3
S3_BUCKET=sigplatform-uploads-CHANGE-ME
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_BACKEND=real
DETECT_THRESHOLD=0.40
MATCH_THRESHOLD=0.85
HF_DATASET_REPO=saoodalam07/signature-dataset
HF_WEBHOOK_SECRET=CHANGE-ME-long-random-string
